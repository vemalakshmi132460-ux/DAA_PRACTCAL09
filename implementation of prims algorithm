
#include <iostream>
using namespace std;

int main() {
    int a[5][5] = {
        {0, 2, 0, 6, 0},
        {2, 0, 3, 8, 5},
        {0, 3, 0, 0, 7},
        {6, 8, 0, 0, 9},
        {0, 5, 7, 9, 0}
    };

    int visited[5] = {1, 0, 0, 0, 0};
    int edges = 0, cost = 0;

    cout << "Edges in MST:\n";

    while (edges < 4) {
        int min = 999, u = -1, v = -1;

        for (int i = 0; i < 5; i++) {
            if (visited[i]) {
                for (int j = 0; j < 5; j++) {
                    if (!visited[j] && a[i][j] != 0 &&
                        a[i][j] < min) {
                        min = a[i][j];
                        u = i;
                        v = j;
                    }
                }
            }
        }

        cout << u << " - " << v << " : " << min << endl;
        visited[v] = 1;
        cost += min;
        edges++;
    }

    cout << "Minimum Cost = " << cost;
    return O;

]
